{
  "adapter": "marketing_json",
  "source_file": "../../i18n/en.json",
  "output_dir": "../../i18n",
  "locales": {
    "ja": "ja.json",
    "tw": "zh-TW.json",
    "kr": "ko.json"
  },
  "provider": "openai",
  "model": "gpt-5.4-mini",
  "processing_mode": "standard",
  "batch_size": 30,
  "max_workers": 4,
  "use_structured_output": true,
  "send_temperature": false,
  "temperature": 0.2,
  "max_tokens": 8000,
  "batch_api": false,
  "batch_poll_interval_seconds": 15,
  "batch_timeout_seconds": 86400,
  "check_glossary_compliance": true,
  "check_length_ratio": true,
  "section_depth": 1,
  "nested_json": false,
  "normalize_english_first": true,
  "write_corrected_english": true,
  "corrected_english_file": "en.corrected.json",
  "review_existing_when_english_changes": true,
  "preserve_existing_when_unchanged": true,
  "translation_memory_file": "localization_cache.json",
  "core_glossary_file": "kbkx_glossary.json",
  "marketing_glossary_file": "marketing_glossary.json",
  "seo_prefixes": [
    "meta",
    "seo",
    "og",
    "twitter"
  ],
  "marketing_prefixes": [
    "hero",
    "home",
    "about",
    "partners",
    "hotels",
    "solutions",
    "cta"
  ],
  "technical_prefixes": [
    "api",
    "integration",
    "developer"
  ],
  "qa_report_file": "marketing_localization_qa.json",
  "site_copy_map_file": "marketing_copy_map.json",
  "request_timeout_seconds": 180,
  "max_retries": 3
}
