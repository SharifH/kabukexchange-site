# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
# The scripts auto-load `.env` but never override a variable already set in your shell.

# For the OpenAI provider (default):
OPENAI_API_KEY=sk-...

# For the Claude provider (set "provider": "anthropic" in the config):
# ANTHROPIC_API_KEY=sk-ant-...
